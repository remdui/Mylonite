# Optional Docker Compose overrides.
# Mylonite runs out of the box without this file.
# Copy to .env only when you want to override defaults.

MYLONITE_CONFIG_DIR=./runtime/config
MYLONITE_DATA_DIR=./runtime/data
MYLONITE_CONTENT_DIR=./content
MYLONITE_BIND_PORT=8000

# Linux-friendly defaults for bind-mounted file ownership.
# Keep 1000:1000 for most systems.
# If your local user/group IDs differ (for example 1001), override these.
MYLONITE_PUID=1000
MYLONITE_PGID=1000
