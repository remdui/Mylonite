# Python bytecode / caches
__pycache__/
*.py[cod]
*.so

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local env files
.env
.env.local
.env.*.local

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local databases
db.sqlite3
db.sqlite3-journal

# Runtime config: keep examples, ignore real local config
runtime/config/.env
runtime/config/deploy.toml

# Runtime data: generated / persistent local state
runtime/data/*
!runtime/data/.gitignore

# Content: keep tracked examples and docs, ignore real local content files
content/**
!content/
!content/**/
!content/**/*.example
!content/**/.gitignore
!content/**/README.md

# Optional local media or artifacts elsewhere, if added later
media/
staticfiles/

# Jupyter
.ipynb_checkpoints/

# Dev tools
code_overview.py
project_dump.txt

# Poetry files
poetry.lock
